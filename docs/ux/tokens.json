        "accent": "#0969DA",
        "onAccent": "#FFFFFF",
        "focusRing": "#0969DA"
      },
      "state": {
        "sample": { "stroke": "#0550AE", "casing": "#FFFFFF" },
        "found": { "stroke": "#1A7F37", "casing": "#FFFFFF" },
        "inferred": { "stroke": "#9A6700", "casing": "#FFFFFF" },
        "rejected": { "stroke": "#CF222E", "casing": "#FFFFFF" }
      }
    },
    "dark": {
      "surface": {
        "window": "#0D1117",
        "panel": "#161B22",
        "canvas": "#010409",
        "text": "#E6EDF3",
