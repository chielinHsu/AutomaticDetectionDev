        "inferred": { "stroke": "#D29922", "casing": "#0D1117" },
        "rejected": { "stroke": "#FF7B72", "casing": "#0D1117" }
      }
    }
  },
  "overlay": {
    "note": "Boxes drawn on the image use this palette in BOTH themes. The image does not change with the theme, and most boards are dark. board.* are synthetic reference colors, not measured from real boards (unverified).",
    "state": {
      "sample": { "stroke": "#58A6FF", "casing": "#0D1117" },
      "found": { "stroke": "#3FB950", "casing": "#0D1117" },
      "inferred": { "stroke": "#D29922", "casing": "#0D1117" },
      "rejected": { "stroke": "#FF7B72", "casing": "#0D1117" }
    },
    "board": { "green": "#1A5C3A", "blue": "#1F3F78", "black": "#16181D" },
    "region": {
      "stroke": "#FFFFFF",
      "casing": "#0D1117",
      "fillOpacity": 0.1,
      "width": 1.5,
      "lineStyle": "solid",
      "note": "The area the user dragged to scan. Solid, thin, with a light fill. It must not look like a state box."
    },
    "definition": {
      "stroke": "#FFFFFF",
      "casing": "#0D1117",
      "widthBody": 2,
      "widthPin": 1.5,
      "pinFillOpacity": 0.18,
      "note": "Boxes in the component type editor. They are definitions, not match results, so they use a neutral color."
    }
  },
  "stateStyle": {
    "sample": { "lineStyle": "solid", "width": 3, "dash": [], "cap": "butt", "marker": "S" },
    "found": { "lineStyle": "solid", "width": 2, "dash": [], "cap": "butt", "marker": "F" },
    "inferred": { "lineStyle": "dashed", "width": 2, "dash": [8, 4], "cap": "butt", "marker": "I" },
    "rejected": { "lineStyle": "dotted", "width": 2, "dash": [0, 4], "cap": "round", "marker": "R" },
    "selected": { "widthDelta": 1, "handles": true },
    "casingExtraWidth": 2,
    "dashUnit": "px along the path. Divide by width for QPen::setDashPattern, which counts in pen widths.",
    "hierarchy": {
      "note": "A component draws all its boxes in the style of its own state. The selected component adds 1 to every width. Labels show the part number and the score."
    }
  },
  "sizes": {
    "unit": "device-independent px",
    "strokeIsCosmetic": true,
    "handleVisual": 8,
    "handleHit": 24,
    "minHitTarget": 24,
    "handlesMoveOutsideBelow": 72,
    "toolbarButton": 36,
    "statusBarHeight": 28,
    "dockMinWidth": 280,
    "messageBarHeight": 96,
    "windowMin": [1024, 640],
    "spacing": [4, 8, 12, 16, 24]
  },
  "font": { "basePt": 9, "scaleOptions": [1, 1.25, 1.5], "monoFamily": "Consolas" },
  "interaction": {
    "zoomStepPerNotch": 1.1,
    "zoomMinPercent": 5,
    "zoomMaxPercent": 3200,
    "fitMarginPx": 24,
    "minSampleSidePx": 8
