{
  "schema": 1,
  "version": "0.1.0",
  "status": "overlay palette confirmed by the user on 2026-10-05; the rest is proposed until S02 uses it",
  "note": "Design tokens for the AOI UI (S01). Colors are per theme. Line styles are shared by both themes, so the state is readable without color. Run `node tools/check-contrast.mjs` to verify. Run it with --write to refresh contrastResults after any color change. S02 turns these tokens into QPalette / QSS.",
  "themes": {
    "light": {
      "surface": {
        "window": "#F6F8FA",
        "panel": "#FFFFFF",
        "canvas": "#D8DEE4",
        "text": "#1F2328",
