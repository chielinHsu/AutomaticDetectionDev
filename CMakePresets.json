{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/Qt/6.12.0/msvc2022_64",
        "OpenCV_DIR": "D:/opencv/opencv/build/x64/vc16/lib",
        "AOI_WITH_OPENCV": "OFF",
        "AOI_WITH_HALCON": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug-opencv",
      "displayName": "Debug + OpenCV",
      "inherits": "debug",
      "cacheVariables": { "AOI_WITH_OPENCV": "ON" }
    },
    {
      "name": "release-opencv",
      "displayName": "Release + OpenCV",
      "inherits": "release",
      "cacheVariables": { "AOI_WITH_OPENCV": "ON" }
    },
    {
      "name": "debug-halcon",
      "displayName": "Debug + OpenCV + HALCON",
      "inherits": "debug",
      "cacheVariables": { "AOI_WITH_OPENCV": "ON", "AOI_WITH_HALCON": "ON" }
    },
    {
      "name": "release-halcon",
      "displayName": "Release + OpenCV + HALCON",
      "inherits": "release",
      "cacheVariables": { "AOI_WITH_OPENCV": "ON", "AOI_WITH_HALCON": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "debug-opencv", "configurePreset": "debug-opencv" },
    { "name": "release-opencv", "configurePreset": "release-opencv" },
    { "name": "debug-halcon", "configurePreset": "debug-halcon" },
    { "name": "release-halcon", "configurePreset": "release-halcon" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen", "QT_QPA_FONTDIR": "C:/Windows/Fonts" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "configurePreset": "relwithdebinfo",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "debug-opencv",
      "inherits": "base",
      "configurePreset": "debug-opencv",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "release-opencv",
      "inherits": "base",
      "configurePreset": "release-opencv",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "debug-halcon",
      "inherits": "base",
      "configurePreset": "debug-halcon",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "release-halcon",
      "inherits": "base",
      "configurePreset": "release-halcon",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "perf",
      "inherits": "base",
      "configurePreset": "release",
      "filter": { "include": { "label": "perf" } },
      "output": { "outputOnFailure": true, "verbosity": "verbose" }
    },
    {
      "name": "perf-opencv",
      "inherits": "base",
      "configurePreset": "release-opencv",
      "filter": { "include": { "label": "perf" } },
      "output": { "outputOnFailure": true, "verbosity": "verbose" }
    },
    {
      "name": "perf-halcon",
      "inherits": "base",
      "configurePreset": "release-halcon",
      "filter": { "include": { "label": "perf" } },
      "output": { "outputOnFailure": true, "verbosity": "verbose" }
    }
  ]
}
