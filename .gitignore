# Build output（qmake：命令列的建置在 build/qmake-*，Qt Creator 預設在 AiInspTool/build/；ADR-018）
build/
out/
*.user

# Qt Creator 的專案設定與程式碼模型快取（每台機器不同）
.qtcreator/
.qtc_clangd/
*.pro.user*
.vs/
.vscode/
.idea/

# Qt generated
*.autosave
moc_*.cpp
ui_*.h
qrc_*.cpp

# Compiler / linker output
*.obj
*.o
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.exp
# S08：HALCON 的匯入程式庫要進版控（第三方 SDK 的複本，見 third_party/halcon/README.md）
!third_party/halcon/lib/x64-win64/halconcpp.lib

# Performance output (budgets and baselines ARE tracked, raw runs are not)
perf/results/*
!perf/results/.gitkeep

# Real production images (large, may be confidential). Use synthetic data in testdata/.
/data/
*.local.*

# OS
Thumbs.db
.DS_Store

# Claude Code local state
.claude/settings.local.json

# AI agent local state
.claude/worktrees/
CLAUDE.local.md
