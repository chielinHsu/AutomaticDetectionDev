# Normalize line endings. Text is LF in the repository and in the working copy.
* text=auto eol=lf

# Windows-only scripts need CRLF on checkout
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.bmp  binary
*.tif  binary
*.tiff binary
*.mp4  binary
*.dll  binary
*.lib  binary

# Large test images: enable Git LFS later if real images enter the repository.
# *.tif filter=lfs diff=lfs merge=lfs -text
